{#
  Pointing HOME and the XDG directories at /config makes qBittorrent keep its
  profile in the flat layout under /config/qBittorrent that deployments have
  always had (the image's own entrypoint would use --profile and a nested
  config/data/cache split instead - see the systemd unit template).
#}
HOME=/config
XDG_CONFIG_HOME=/config
XDG_DATA_HOME=/config
XDG_CACHE_HOME=/config/.cache
TZ={{ qbittorrent_environment_variables_tz }}

{{ qbittorrent_environment_variables_additional_variables }}
